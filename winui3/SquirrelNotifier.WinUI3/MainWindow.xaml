<Window
    x:Class="SquirrelNotifier.WinUI3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:models="using:SquirrelNotifier.WinUI3.Models"
    xmlns:tb="using:H.NotifyIcon"
    mc:Ignorable="d"
    Title="Squirrel Notifier">
    <Grid Padding="16"
          RowDefinitions="Auto,Auto,*,Auto"
          RowSpacing="12">
        <Grid.Resources>
            <XamlUICommand x:Key="TrayOpenCommand" ExecuteRequested="OnTrayOpenCommandExecuteRequested"/>
            <XamlUICommand x:Key="TrayRightClickCommand" ExecuteRequested="OnTrayRightClickCommandExecuteRequested"/>
        </Grid.Resources>
        <!--
            右クリックメニューは ContextFlyout ではなく Win32 のポップアップメニューで表示する。
            H.NotifyIcon の ContextMenuMode.PopupMenu はネイティブメニューへ変換する際に
            MenuFlyoutItem.IsEnabled も ContextMenuThemeMode も反映しないため、活性制御と
            ダークテーマ追従のどちらも実現できない（#202）。MenuActivation="None" で
            ライブラリ側のメニュー表示を止め、RightClickCommand から自前で表示する。
        -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        Visibility="Collapsed"
                        IconSource="ms-appx:///Assets/squirrel-notifier.ico"
                        ToolTipText="Squirrel Notifier"
                        NoLeftClickDelay="True"
                        PopupActivation="None"
                        MenuActivation="None"
                        LeftClickCommand="{StaticResource TrayOpenCommand}"
                        RightClickCommand="{StaticResource TrayRightClickCommand}"/>
        <!--
            TrayPopup はここでは設定しない。H.NotifyIcon 2.5.0 の TrayPopup セッターは
            同期的に専用の Window（HWND + AppWindow）を生成するため、XAML ロード中に代入すると
            MainWindow 自身の構築が完了する前に別 Window を作ることになり、cold start で
            E_UNEXPECTED を返して XamlParseException でプロセスが落ちる（#229）。
            代入は MainWindow.AttachTrayPopup() で行う。
        -->
        <StackPanel Spacing="6">
            <TextBlock Text="Squirrel Notifier"
                       FontSize="20"
                       FontWeight="SemiBold"/>
            <TextBlock x:Name="StatusText"
                       Text="Stopped"/>
            <InfoBar x:Name="OnboardingInfoBar"
                     Title="自動起動が未設定です"
                     Message="設定の「自動起動」を有効にすると、ログイン時にバックグラウンドで動作を開始します。"
                     Severity="Warning"
                     IsOpen="False"
                     IsClosable="True"
                     Margin="0,4,0,0">
                <InfoBar.ActionButton>
                    <Button Content="設定へ移動" Click="OnGoToSettingsClick"/>
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar x:Name="AuthRequiredInfoBar"
                     Title="mcp-gateway の認証が必要です"
                     Message="mcp-gateway への認証が完了していないため、通知の購読やレビュー登録が失敗します。「mcp-gateway にログイン」で device flow 認証を開始してください。"
                     Severity="Error"
                     IsOpen="False"
                     IsClosable="True"
                     Margin="0,4,0,0">
                <InfoBar.ActionButton>
                    <Button Content="mcp-gateway にログイン" Click="OnLoginToGatewayClick"/>
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar x:Name="CopyFeedbackInfoBar"
                     Severity="Success"
                     IsOpen="False"
                     IsClosable="True"
                     Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8">
            <StackPanel Spacing="6">
                <TextBlock Text="レビューを手動開始" FontWeight="SemiBold"/>
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBox Grid.Column="0"
                             x:Name="PrReferenceBox"
                             AutomationProperties.Name="PR URL または owner/repo#123"
                             PlaceholderText="https://github.com/owner/repo/pull/123 または owner/repo#123"/>
                    <ComboBox Grid.Column="1" x:Name="ReasonComboBox" MinWidth="180"
                              AutomationProperties.Name="レビュー開始理由（reason）"/>
                    <Button Grid.Column="2" x:Name="EnqueueReviewButton" Content="レビュー開始" Click="OnEnqueueReviewClick"/>
                </Grid>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" x:Name="PaneViewport" SizeChanged="OnPaneViewportSizeChanged"
                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Grid x:Name="PaneGrid" MinHeight="400" VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="64"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="64"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="64"/>
                </Grid.RowDefinitions>
                <Expander Grid.Row="0"
                          x:Name="SettingsExpander"
                          Header="Settings"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch">
                    <ScrollViewer x:Name="SettingsScrollViewer" Height="160" MinHeight="80"
                                  MaxHeight="80"
                                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                              ColumnDefinitions="Auto,*"
                              RowSpacing="8"
                              ColumnSpacing="8"
                              Margin="0,8,0,8">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Command Path:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="CommandPathBox" TextChanged="OnSettingChanged"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Arguments:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="ArgumentsBox" TextChanged="OnSettingChanged"/>

                            <Grid Grid.Row="2" Grid.ColumnSpan="2" RowDefinitions="Auto,Auto"
                                  ColumnDefinitions="Auto,*" RowSpacing="4" ColumnSpacing="8">
                                <TextBlock Text="Gateway URL:" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" x:Name="GatewayUrlBox" TextChanged="OnSettingChanged"
                                         PlaceholderText="http://localhost:8080/mcp/thread-owl"/>
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal"
                                            HorizontalAlignment="Right" Spacing="4">
                                    <Button Content="コンテナから自動設定" Click="OnAutoDetectGatewayUrlClick"/>
                                    <Button x:Name="GatewayLoginButton" Content="ログイン" Click="OnLoginToGatewayClick"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Resource URIs:" VerticalAlignment="Top" Margin="0,4,0,0"/>
                            <StackPanel Grid.Row="3" Grid.Column="1" Spacing="4">
                                <TextBox x:Name="ResourceUrisBox"
                                         AcceptsReturn="True"
                                         Height="60"
                                         TextWrapping="Wrap"
                                         PlaceholderText="1行に1つのURIを入力"
                                         TextChanged="OnSettingChanged"/>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Button Content="URI を追加" Click="OnSelectResourceUriClick"/>
                                    <Button Content="MCP から取得" Click="OnFetchResourceUriFromMcpClick"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Timeout (ms):" VerticalAlignment="Center"/>
                            <NumberBox Grid.Row="4" Grid.Column="1" x:Name="TimeoutBox" Minimum="1" Maximum="300000" ValueChanged="OnTimeoutChanged"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Reviewer Preset:" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="5" Grid.Column="1" x:Name="ReviewerPresetComboBox"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="OnReviewerPresetSelectionChanged"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Reviewer Path:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="6" Grid.Column="1" x:Name="ReviewerPathBox" TextChanged="OnSettingChanged"/>

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Reviewer Args:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="7" Grid.Column="1" x:Name="ReviewerArgumentsBox" TextChanged="OnSettingChanged"/>

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Reviewer Resume Args:" VerticalAlignment="Top" Margin="0,4,0,0"/>
                            <StackPanel Grid.Row="8" Grid.Column="1" Spacing="2">
                                <TextBox x:Name="ReviewerResumeArgumentsBox" TextChanged="OnSettingChanged"/>
                                <TextBlock x:Name="ReviewerSessionResumeSupportText" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>

                            <TextBlock Grid.Row="9" Grid.Column="0" Text="Reviewed Preset:" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="9" Grid.Column="1" x:Name="ReviewedPresetComboBox"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="OnReviewedPresetSelectionChanged"/>

                            <TextBlock Grid.Row="10" Grid.Column="0" Text="Reviewed Path:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="10" Grid.Column="1" x:Name="ReviewedPathBox" TextChanged="OnSettingChanged"/>

                            <TextBlock Grid.Row="11" Grid.Column="0" Text="Reviewed Args:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="11" Grid.Column="1" x:Name="ReviewedArgumentsBox" TextChanged="OnSettingChanged"/>

                            <TextBlock Grid.Row="12" Grid.Column="0" Text="Reviewed Resume Args:" VerticalAlignment="Top" Margin="0,4,0,0"/>
                            <StackPanel Grid.Row="12" Grid.Column="1" Spacing="2">
                                <TextBox x:Name="ReviewedResumeArgumentsBox" TextChanged="OnSettingChanged"/>
                                <TextBlock x:Name="ReviewedSessionResumeSupportText" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>

                            <TextBlock Grid.Row="13" Grid.Column="0" Text="Checkout Mappings:" VerticalAlignment="Top" Margin="0,4,0,0"/>
                            <TextBox Grid.Row="13" Grid.Column="1" x:Name="RepositoryCheckoutMappingsBox"
                                     AcceptsReturn="True"
                                     Height="60"
                                     TextWrapping="NoWrap"
                                     PlaceholderText="owner/repo=C:\src\repo（1行に1件）"
                                     TextChanged="OnSettingChanged"/>

                            <TextBlock Grid.Row="14" Grid.Column="0" Text="Launcher Timeout:" VerticalAlignment="Center"/>
                            <NumberBox Grid.Row="14" Grid.Column="1" x:Name="LauncherTimeoutBox" Minimum="1" Maximum="7200000" ValueChanged="OnTimeoutChanged"/>

                            <TextBlock Grid.Row="15" Grid.Column="0" Text="前回セッションを引き継ぐ（resume）:" VerticalAlignment="Center"/>
                            <ToggleSwitch Grid.Row="15" Grid.Column="1" x:Name="SessionResumeToggle"
                                          OnContent="有効" OffContent="無効"
                                          Toggled="OnSessionResumeToggled"/>

                            <TextBlock Grid.Row="16" Grid.Column="0" Text="レビュー自動開始:" VerticalAlignment="Center"/>
                            <ToggleSwitch Grid.Row="16" Grid.Column="1" x:Name="AutoReviewStartToggle"
                                          OnContent="有効" OffContent="無効"
                                          Toggled="OnAutoReviewStartToggled"/>

                            <TextBlock Grid.Row="17" Grid.Column="0" Text="ライブログ自動クローズ:" VerticalAlignment="Center"/>
                            <ToggleSwitch Grid.Row="17" Grid.Column="1" x:Name="LiveLogAutoCloseToggle"
                                          OnContent="有効" OffContent="無効"
                                          Toggled="OnLiveLogAutoCloseToggled"/>

                            <TextBlock Grid.Row="18" Grid.Column="0" Text="自動起動:" VerticalAlignment="Center"/>
                            <ToggleSwitch Grid.Row="18" Grid.Column="1" x:Name="AutoStartToggle"
                                          OnContent="有効" OffContent="無効"
                                          Toggled="OnAutoStartToggled"/>

                            <TextBlock Grid.Row="19" Grid.Column="0" Text="タスク状態:" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="19" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="AutoStartStatusText" VerticalAlignment="Center" Text="確認中..."/>
                                <Button x:Name="RepairAutoStartButton" Content="修復" Click="OnRepairAutoStartClick" IsEnabled="False"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Expander>

                <controls:ContentSizer Grid.Row="1" Height="12" HorizontalAlignment="Stretch"
                                       Orientation="Horizontal" TargetControl="{x:Bind SettingsScrollViewer}"
                                       Visibility="{x:Bind SettingsExpander.IsExpanded, Mode=OneWay}"
                                       AutomationProperties.Name="Settings の高さを調整"
                                       ToolTipService.ToolTip="ドラッグまたは上下キーで設定欄の高さを調整"/>
                <Border Grid.Row="2"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8">
                    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="レートリミット状態" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="更新" Click="OnRefreshRateLimitClick"/>
                            </Grid>
                            <InfoBar x:Name="AutoPauseInfoBar"
                                     IsOpen="False"
                                     IsClosable="False"
                                     Severity="Warning"
                                     Title="Auto-Pause 中（新規エージェント起動を停止）"/>
                            <InfoBar x:Name="AutoPauseNotApplicableInfoBar"
                                     IsOpen="False"
                                     IsClosable="False"
                                     Severity="Warning"
                                     Title="Auto-Pause の対象外のランチャーがあります"/>
                            <InfoBar x:Name="LegacySchemaInfoBar"
                                     IsOpen="False"
                                     IsClosable="False"
                                     Severity="Warning"
                                     Title="statusline snapshot が旧形式です">
                                <InfoBar.ActionButton>
                                    <Button Content="移行手順を見る" Click="OnOpenStatuslineDocsClick"/>
                                </InfoBar.ActionButton>
                            </InfoBar>
                            <TextBlock Text="監視対象:" FontSize="11" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                            <ItemsControl x:Name="RateLimitAgentList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="12"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:RateLimitAgentOption">
                                        <CheckBox Content="{x:Bind DisplayName}"
                                                  IsChecked="{x:Bind IsMonitored, Mode=TwoWay}"
                                                  IsEnabled="{x:Bind IsAvailable}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ListView x:Name="RateLimitList"
                                      SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:RateLimitInfo">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,2">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="{x:Bind DisplayLabel}" FontWeight="Medium"/>
                                                <TextBlock Text="{x:Bind ResetAtDisplay}" FontSize="11" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Content="{x:Bind ReminderButtonText, Mode=OneWay}"
                                                    Click="OnToggleRateLimitReminderClick"
                                                    CommandParameter="{x:Bind}"
                                                    VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <controls:GridSplitter Grid.Row="3" Height="12" HorizontalAlignment="Stretch"
                                       ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                                       AutomationProperties.Name="レートリミットとイベントの高さを調整" ToolTipService.ToolTip="ドラッグまたは上下キーで高さを調整"/>
                <Border Grid.Row="4" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="8">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Text="Recent review events"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4"/>
                        <ListView Grid.Row="1" x:Name="ReviewEventList"
                                   SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ReviewEvent">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,2">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{x:Bind Message}" TextWrapping="Wrap" FontWeight="Medium"/>
                                            <HyperlinkButton Content="{x:Bind PrCaption}"
                                                             Click="OnOpenPrClick"
                                                             CommandParameter="{x:Bind PrUrl}"
                                                             FontSize="11"
                                                             Padding="0"
                                                             HorizontalAlignment="Left"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <SplitButton Content="レビューする"
                                                         AutomationProperties.Name="reviewer としてレビューを起動"
                                                         Click="OnLaunchReviewerClick"
                                                         CommandParameter="{x:Bind}">
                                                <SplitButton.Flyout>
                                                    <MenuFlyout Placement="Bottom">
                                                        <MenuFlyoutItem Text="コマンドをコピー"
                                                                        Click="OnCopyReviewerCommandClick"
                                                                        CommandParameter="{x:Bind}"/>
                                                    </MenuFlyout>
                                                </SplitButton.Flyout>
                                            </SplitButton>
                                            <SplitButton Content="レビューに対応"
                                                         AutomationProperties.Name="reviewed としてレビュー対応を起動"
                                                         Click="OnLaunchReviewedClick"
                                                         CommandParameter="{x:Bind}">
                                                <SplitButton.Flyout>
                                                    <MenuFlyout Placement="Bottom">
                                                        <MenuFlyoutItem Text="コマンドをコピー"
                                                                        Click="OnCopyReviewedCommandClick"
                                                                        CommandParameter="{x:Bind}"/>
                                                    </MenuFlyout>
                                                </SplitButton.Flyout>
                                            </SplitButton>
                                            <Button AutomationProperties.Name="イベントを片付ける"
                                                    ToolTipService.ToolTip="このイベントを一覧から片付ける"
                                                    Click="OnDismissEventClick"
                                                    CommandParameter="{x:Bind}"
                                                    Padding="6,4">
                                                <FontIcon Glyph="&#xE711;" FontSize="12"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
                <controls:GridSplitter Grid.Row="5" Height="12" HorizontalAlignment="Stretch"
                                       ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                                       AutomationProperties.Name="イベントとログの高さを調整" ToolTipService.ToolTip="ドラッグまたは上下キーで高さを調整"/>
                <Border Grid.Row="6" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="8">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Text="Recent activity"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4"/>
                        <ListView Grid.Row="1" x:Name="LogList"
                                  SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
            <Button x:Name="StartButton" Content="購読を開始" Click="OnStartClick"/>
            <Button x:Name="StopButton" Content="購読を停止" Click="OnStopClick"/>
            <Button x:Name="RetryButton" Content="再試行" Click="OnRetryClick"/>
            <Button Content="Open log folder" Click="OnOpenLogFolder"/>
            <Button Content="Minimize to tray" Click="OnExit"/>
        </StackPanel>
    </Grid>
</Window>
